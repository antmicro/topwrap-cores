CAPI=2:

# Copyright (c) 2026 Antmicro <www.antmicro.com>
# SPDX-License-Identifier: Apache-2.0

name: antmicro.com:topwrap-cores:axi_cdc_wrapper:0.1
description: Package generated by 'topwrap package'
filesets:
  topwrap:
    files:
    - axi_cdc_wrapper.yaml: {file_type: topwrapModule}
  rtl:
    files:
    - axi_cdc_wrapper.sv: {file_type: systemVerilogSource}
    depend:
    - pulp-platform.org::axi:0.39.10

parameters:
  ID_WIDTH:
    datatype: int
    paramtype: vlogparam
    default: 1

targets:
  default:
    filesets: [rtl]
  lint:
    parameters: [ID_WIDTH]
    default_tool: verilator
    filesets: [rtl]
    tools:
      verilator:
        mode: lint-only
        verilator_options: ["-Wno-WIDTHEXPAND"]
    toplevel: axi_cdc_wrapper
  build:
    parameters: [ID_WIDTH]
    default_tool: verilator
    filesets: [rtl]
    tools:
      verilator:
        mode: binary
        verilator_options: ["-Wno-WIDTHEXPAND", "--timing"]
    toplevel: axi_cdc_wrapper
