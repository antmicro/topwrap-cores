CAPI=2:

# Copyright (c) 2026 Antmicro <www.antmicro.com>
# SPDX-License-Identifier: Apache-2.0

name: antmicro.com:topwrap-cores:el2_veer_wrapper:0.1
description: Package generated by 'topwrap package'
filesets:
  topwrap:
    files:
    - veer_el2.yaml: {file_type: topwrapModule}
  rtl:
    depend:
    - antmicro.com:topwrap-cores:el2_pkg:0.1
    - antmicro.com:topwrap-cores:axi4_to_ahb:0.1
    - antmicro.com:topwrap-cores:el2_rtl:0.1
targets:
  default:
    filesets: [rtl]
  lint:
    default_tool: verilator
    filesets: [rtl]
    tools:
      verilator:
        mode: lint-only
        verilator_options: ["-Wno-WIDTHTRUNC"]
    toplevel: el2_veer_wrapper
  build:
    default_tool: verilator
    filesets: [rtl]
    tools:
      verilator:
        mode: binary
        verilator_options: ["-Wno-WIDTHTRUNC", "--timing"]
    toplevel: el2_veer_wrapper
